{
    "name": "chisnall/debug",
    "version": "1.0.0",
    "description": "Web debugger for PHP",
    "license": "MIT",
    "authors": [
        {
            "name": "Lee Chisnall",
            "email": "lee.chisnall@royallondon.com"
        }
    ],
    "repositories": [
        {
            "packagist.org": false
        },
        {
            "type": "path",
            "url": "/rlg/web/app/lchisnall/composer/*/*",
            "options": {
                "symlink": true
            }
        }
    ],
    "require": {
        "php": "^7.0",
        "symfony/var-dumper": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "5.7.27"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Udemy\\App\\": "tests/Udemy/App/"
        },
        "files": [
            "app/Core/functions.php",
            "src/helpers.php",
            "tests/Udemy/udemyFunctions.php"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
