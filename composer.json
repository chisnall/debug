{
    "name": "chisnall/debug",
    "version": "1.0.0",
    "description": "Web debugger for PHP",
    "license": "MIT",
    "authors": [
        {
            "name": "Lee Chisnall",
            "email": "lee.chisnall@royallondon.com"
        }
    ],
    "require": {
        "php": "^7.4",
        "symfony/var-dumper": "^5.4"
    },
    "require-dev": {
        "phpunit/phpunit": "5.7.27"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/Core/functions.php",
            "src/helpers.php"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "audit": {
            "ignore": [
                "PKSA-z3gr-8qht-p93v"
            ]
        }
    }
}
